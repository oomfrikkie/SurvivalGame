# Auto-detect text files and normalize line endings
* text=auto

# Unreal Engine binary assets — store in Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.uptnl filter=lfs diff=lfs merge=lfs -text

# Common binary formats — force binary (no line-ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tga binary
*.tiff binary
*.psd binary
*.exr binary
*.hdr binary

*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary

*.fbx binary
*.obj binary
*.blend binary

*.zip binary
*.7z binary
*.rar binary

*.ttf binary
*.otf binary

# Unreal config files — keep LF on all platforms for consistency
*.ini text eol=lf
*.uproject text eol=lf
